# Copy this file to .env and fill in your own values.
# Never commit your real .env file to GitHub.

# Port the server listens on (default 3000)
PORT=3000

# "development" shows detailed error messages. Use "production" when deployed.
NODE_ENV=development

# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/evently

# Secret used to sign login tokens (required). Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Optional: email notifications for booking approvals and rejections.
# Leave these empty to turn email off.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
